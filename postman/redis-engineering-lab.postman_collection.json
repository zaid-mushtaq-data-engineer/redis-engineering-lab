{
  "info": {
    "name": "Redis Engineering Lab",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminKey", "value": "change-me-admin-key" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Wireless Mouse\",\"description\":\"Bluetooth mouse\",\"price\":799.00}"
        },
        "url": "{{baseUrl}}/api/admin/products"
      }
    },
    {
      "name": "Rate limit burst (run 11x in Collection Runner)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "description": "Stage 8: shared per-IP bucket across public GETs. Expect X-RateLimit-* on 200/404; 11th rapid call → 429 + Retry-After."
      }
    },
    {
      "name": "Public product detail",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
    },
    {
      "name": "Public product detail (cache hit)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
    },
    {
      "name": "Public product list",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products?page=0&size=20" }
    },
    {
      "name": "Public product list (cache hit)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products?page=0&size=20" }
    },
    {
      "name": "Invalid pagination size 51",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products?size=51" }
    },
    {
      "name": "Public inventory",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory/{{productId}}" }
    },
    {
      "name": "Public inventory (cache hit)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory/{{productId}}" }
    },
    {
      "name": "Admin inventory",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }],
        "url": "{{baseUrl}}/api/admin/inventory/{{productId}}"
      }
    },
    {
      "name": "Admin product list",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }],
        "url": "{{baseUrl}}/api/admin/products?page=0&size=20"
      }
    },
    {
      "name": "Admin product detail",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }],
        "url": "{{baseUrl}}/api/admin/products/{{productId}}"
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Wireless Mouse\",\"description\":\"Updated\",\"price\":849.00,\"version\":0}"
        },
        "url": "{{baseUrl}}/api/admin/products/{{productId}}"
      }
    },
    {
      "name": "Activate product",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }],
        "url": "{{baseUrl}}/api/admin/products/{{productId}}/activate"
      }
    },
    {
      "name": "Set inventory",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"stockQuantity\":100,\"version\":0}"
        },
        "url": "{{baseUrl}}/api/admin/inventory/{{productId}}"
      }
    },
    {
      "name": "Increment inventory",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"quantity\":1}" },
        "url": "{{baseUrl}}/api/admin/inventory/{{productId}}/increment"
      }
    },
    {
      "name": "Decrement inventory",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Admin-Key", "value": "{{adminKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\"quantity\":1}" },
        "url": "{{baseUrl}}/api/admin/inventory/{{productId}}/decrement"
      }
    },
    {
      "name": "Deactivate product",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "X-Admin-Key", "value": "{{adminKey}}" }],
        "url": "{{baseUrl}}/api/admin/products/{{productId}}/deactivate"
      }
    }
  ]
}
